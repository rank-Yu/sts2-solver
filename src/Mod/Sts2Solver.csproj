<Project Sdk="Godot.NET.Sdk/4.5.1">
  <!-- 每个游戏分支编译自己的 Runtime，由共用加载器选取。 -->
  <Import Project="$(MSBuildProjectDirectory)/local.props" Condition="Exists('$(MSBuildProjectDirectory)/local.props')" />
  <Import Project="GameTarget.props" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>Sts2Solver.Runtime</AssemblyName>
    <RootNamespace>Sts2Solver</RootNamespace>
    <Version>$(SolverVersion)</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == '' and '$(OS)' == 'Windows_NT'">$(Sts2Dir)/data_sts2_windows_x86_64</Sts2DataDir>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Dir)/data_sts2_linuxbsd_x86_64</Sts2DataDir>
    <RitsuLibDir Condition="'$(RitsuLibDir)' == ''">$(RitsuWorkshopRoot)/compat/$(RitsuLibReferenceTarget)</RitsuLibDir>
    <RitsuLibReferencesProps>$(RitsuWorkshopRoot)/RitsuLib.References.props</RitsuLibReferencesProps>
    <DefineConstants Condition="'$(EnableModTesting)' == 'true'">$(DefineConstants);STS2_SOLVER_TESTING</DefineConstants>
    <ModOutputDir Condition="'$(EnableModTesting)' == 'true'">$(MSBuildProjectDirectory)/../../artifacts/mod-testing/Sts2Solver</ModOutputDir>
    <ModOutputDir Condition="'$(ModOutputDir)' == ''">$(MSBuildProjectDirectory)/../../artifacts/mod/Sts2Solver</ModOutputDir>
  </PropertyGroup>

  <Import Project="$(RitsuLibReferencesProps)" Condition="Exists('$(RitsuLibReferencesProps)')" />

  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="all" />
    <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
    <Compile Include="../Core/**/*.cs" Exclude="../Core/bin/**;../Core/obj/**" LinkBase="Core" />
    <Compile Include="../Import/**/*.cs" Exclude="../Import/bin/**;../Import/obj/**" LinkBase="Import" />
    <Compile Condition="'$(EnableModTesting)' == 'true'" Include="../TestHost/**/*.cs" Exclude="../TestHost/bin/**;../TestHost/obj/**" LinkBase="TestHost" />
    <ProjectReference Include="../Loader/Sts2Solver.Loader.csproj" ReferenceOutputAssembly="false"
                      AdditionalProperties="Sts2Dir=$(Sts2Dir);Sts2DataDir=$(Sts2DataDir)" />
    <ProjectReference Include="../Core/Sts2Solver.Core.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Import/Sts2Solver.Import.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Condition="'$(EnableModTesting)' == 'true'" Include="../TestHost/Sts2Solver.TestHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="UI/Locales/*.json">
      <LogicalName>Sts2Solver.UI.Locales.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <Reference Include="sts2" HintPath="$(Sts2DataDir)/sts2.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(Sts2DataDir)/0Harmony.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(Sts2DataDir)/GodotSharp.dll" Private="false" />
    <Reference Include="STS2-RitsuLib" HintPath="$(RitsuLibDir)/STS2-RitsuLib.dll" Private="false"
               Condition="!Exists('$(RitsuLibReferencesProps)')" />
  </ItemGroup>

  <Target Name="ValidateSts2SolverInstall" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(Sts2DataDir)/sts2.dll')" Text="找不到 $(Sts2DataDir)/sts2.dll。请检查 src/Mod/local.props。" />
    <Error Condition="!Exists('$(RitsuLibReferencesProps)') and !Exists('$(RitsuLibDir)/STS2-RitsuLib.dll')"
           Text="找不到 RitsuLib 引用。请检查 RitsuWorkshopRoot/RitsuLibReferenceTarget。" />
  </Target>

  <Target Name="PackSts2SolverMod" AfterTargets="Build">
    <RemoveDir Directories="$(ModOutputDir)" />
    <MakeDir Directories="$(ModOutputDir)" />
    <MSBuild Projects="../Loader/Sts2Solver.Loader.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="LoaderAssembly" />
    </MSBuild>
    <Copy SourceFiles="@(LoaderAssembly);$(MSBuildProjectDirectory)/Sts2Solver.json;$(MSBuildProjectDirectory)/../../LICENSE;$(MSBuildProjectDirectory)/../../README.md"
          DestinationFolder="$(ModOutputDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModOutputDir)/$(SolverGameTarget)" />
    <Message Importance="high" Text="Sts2Solver mod packaged: $(ModOutputDir)" />
  </Target>
</Project>
